FROM python:3.11-slim

WORKDIR /app

# Docker Desktop aarch64: idle OMP workers spin and inflate tiny-matrix
# kernel launches ~50x; passive waiting restores near-native latency.
ENV OMP_WAIT_POLICY=passive
ENV OMP_NUM_THREADS=4

COPY requirements.txt .
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch==2.12.0+cpu" && \
    pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
