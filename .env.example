# --- API / Auth ---
PAYSHIELD_DEV_API_KEY=payshield-dev-key-2026
JWT_SECRET=payshield-jwt-secret-dev-2026
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_DAYS=7
ENFORCE_RBAC=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://payshield:payshield@localhost:5432/payshield

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Env Security ---
# AES-256 encryption key for payment data at rest (PCI-DSS 3.4). Dev-only value;
# rotate to a KMS-managed secret in production.
ENCRYPTION_KEY=pay-shield-dev-aes256-key-0001
ENABLE_LLM_INVESTIGATOR=true
ENABLE_HUMAN_REVIEW=true
MFA_ENABLED=false

# --- Regional Compliance ---
DATA_REGION=IN
CROSS_BORDER_REPLICATION=false

# --- Dashboard ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
