# --- API / Auth ---
PAYSHIELD_DEV_API_KEY=payshield-dev-key-2026
JWT_SECRET=payshield-jwt-secret-dev-2026
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_DAYS=7
ENFORCE_RBAC=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://payshield:payshield@localhost:5432/payshield

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Env Security ---
ENCRYPTION_KEY=
ENABLE_LLM_INVESTIGATOR=false
ENABLE_HUMAN_REVIEW=false
MFA_ENABLED=false

# --- Regional Compliance ---
DATA_REGION=IN
CROSS_BORDER_REPLICATION=false

# --- Dashboard ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
